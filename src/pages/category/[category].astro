---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { CATEGORIES } from "../../../site.config.mjs";
import { getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category, posts: posts.filter((p) => p.data.categories.includes(category.name)) },
  }));
}

const { category, posts } = Astro.props;
---

<Base title={category.name} description={category.description}>
  <div class="container narrow page">
    <p class="kicker">Section</p>
    <h1>{category.name}</h1>
    <p class="desc">{category.description}</p>
    {posts.length ? <PostList posts={posts} /> : <p class="meta">No posts in this section yet.</p>}
  </div>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
  }
  h1 {
    font-size: 2.4rem;
    margin: 0.3rem 0 0.5rem;
  }
  .desc {
    color: var(--text-muted);
    margin: 0 0 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--rule-strong);
  }
</style>
