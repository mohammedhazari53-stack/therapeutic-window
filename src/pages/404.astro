---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="container narrow page">
    <h1>Page not found</h1>
    <p>That page doesn't exist, or it has moved. <a href="/">Go to the home page</a> or browse the <a href="/archive/">archive</a>.</p>
  </div>
</Base>

<style>
  .page {
    padding-top: 4rem;
  }
  h1 {
    font-size: 2.4rem;
    margin-bottom: 1rem;
  }
</style>
