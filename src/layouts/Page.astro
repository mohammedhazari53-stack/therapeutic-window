---
// Layout for simple Markdown pages like About (src/pages/about.md).
import Base from "./Base.astro";
import { SITE } from "../../site.config.mjs";

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="container narrow page">
    <h1>{frontmatter.title}</h1>
    <div class="prose">
      <slot />
    </div>
    {
      frontmatter.showLinks && (
        <p class="links">
          <a href="/subscribe/" class="button">Subscribe</a>
          <a href={SITE.linkedin} class="button outline" target="_blank" rel="me noopener">
            Connect on LinkedIn
          </a>
        </p>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
  }
  h1 {
    font-size: 2.4rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--rule-strong);
  }
  .links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
