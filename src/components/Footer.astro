---
import { SITE, CATEGORIES } from "../../site.config.mjs";
import Wordmark from "./Wordmark.astro";
import SubscribeForm from "./SubscribeForm.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="about">
        <Wordmark />
        <p class="tagline">{SITE.tagline}</p>
        <SubscribeForm variant="plain" heading="" blurb="New posts by email. Free." />
      </div>
      <nav aria-label="Footer">
        <p class="kicker">Sections</p>
        <ul>
          {CATEGORIES.map((c) => <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>)}
          <li><a href="/archive/">Archive</a></li>
        </ul>
      </nav>
      <nav aria-label="More">
        <p class="kicker">More</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/subscribe/">Subscribe</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
        </ul>
      </nav>
    </div>
    <div class="legal">
      <p class="disclaimer">{SITE.disclaimer}</p>
      <p>© {year} {SITE.author}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 2px solid var(--rule-strong);
    padding: 2.5rem 0 2rem;
    font-size: 0.9rem;
  }
  .grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  .tagline {
    color: var(--text-muted);
    font-family: var(--serif);
    font-style: italic;
    margin: 0.5rem 0 1rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
  }
  li {
    margin-bottom: 0.35rem;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .kicker {
    margin: 0;
  }
  .legal {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .legal p {
    margin: 0 0 0.3rem;
  }
  .disclaimer {
    font-style: italic;
  }
</style>
